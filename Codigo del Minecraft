  const min = new THREE.Vector3(pos.x - player.radius, pos.y, pos.z - player.radius);
  const max = new THREE.Vector3(pos.x + player.radius, pos.y + player.height, pos.z + player.radius);
  for (let x = Math.floor(min.x); x <= Math.floor(max.x); x++) for (let y = Math.floor(min.y); y <= Math.floor(max.y); y++) for (let z = Math.floor(min.z); z <= Math.floor(max.z); z++) if (world.isSolid(world.get(x,y,z)) && intersects({min,max}, x,y,z)) return true;
  return false;
}
function tryMove(axis, amount) { const n=player.pos.clone(); n[axis]+=amount; if(!collidesAt(n)){ player.pos.copy(n); return true; } return false; }
function moveHorizontal(dx,dz){ tryMove('x',dx); tryMove('z',dz); }

function updateCameraAndTarget(){
  gfx.camera.position.set(player.pos.x, player.pos.y + player.height * 0.92, player.pos.z);
  gfx.camera.rotation.order = 'YXZ'; gfx.camera.rotation.y = player.yaw; gfx.camera.rotation.x = player.pitch;
  const dir = lookDir(player); const hit = castVoxelRay(world, gfx.camera.position.clone().addScaledVector(dir, 0.001), dir, CONFIG.REACH);
  target = hit;
  if (target) { gfx.outline.visible = true; gfx.outline.position.set(target.x + .5, target.y + .5, target.z + .5); } else gfx.outline.visible = false;
}
function canPlace(x,y,z){ if(!world.canPlaceAt(x,y,z)) return false; const min=new THREE.Vector3(player.pos.x-player.radius,player.pos.y,player.pos.z-player.radius),max=new THREE.Vector3(player.pos.x+player.radius,player.pos.y+player.height,player.pos.z+player.radius); return !intersects({min,max},x,y,z); }
