def parse_args():
    parser = argparse.ArgumentParser(description='Genera el proyecto MiniCraft Modular.')
    parser.add_argument('--serve', action='store_true', help='Levanta servidor HTTP local tras generar archivos.')
    parser.add_argument('--port', type=int, default=8000, help='Puerto del servidor local (default: 8000).')
    return parser.parse_args()


def run_server(port):
    print(f'Servidor: http://127.0.0.1:{port}')
    try:
        subprocess.run(['python', '-m', 'http.server', str(port)], cwd=base, check=True)
    except KeyboardInterrupt:
        print('Servidor detenido por usuario.')


if __name__ == '__main__':
    args = parse_args()
    if args.serve:
        run_server(args.port)
