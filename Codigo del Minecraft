utils_js = """export const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
export const frac = (x) => x - Math.floor(x);
export const lerp = (a, b, t) => a + (b - a) * t;
export function hash2(x, z) { return frac(Math.sin(x * 127.1 + z * 311.7) * 43758.5453123); }
export function noise2(x, z) {
  const x0 = Math.floor(x), z0 = Math.floor(z), x1 = x0 + 1, z1 = z0 + 1;
  const sx = x - x0, sz = z - z0;
  const ux = sx * sx * (3 - 2 * sx), uz = sz * sz * (3 - 2 * sz);
  const n00 = hash2(x0, z0), n10 = hash2(x1, z0), n01 = hash2(x0, z1), n11 = hash2(x1, z1);
  return lerp(lerp(n00, n10, ux), lerp(n01, n11, ux), uz);
}
export function fbm(x, z) {
  let a = 0.5, f = 1, s = 0;
  for (let i = 0; i < 5; i++) { s += a * noise2(x * f, z * f); a *= 0.5; f *= 2; }
  return s;
}
"""

world_js = """import { CONFIG } from './config.js';
import { fbm, hash2 } from './utils.js';

const { WORLD_X, WORLD_Y, WORLD_Z, WATER_LEVEL, BLOCKS, STORAGE_KEY, CHUNK_SIZE } = CONFIG;

export class World {
  constructor() {
    this.blocks = new Map();
    this.heights = new Array(WORLD_X * WORLD_Z).fill(1);
    this.dirtyChunks = new Set();
  }
  key(x, y, z) { return `${x},${y},${z}`; }
  chunkKey(cx, cz) { return `${cx},${cz}`; }
  chunkOf(x, z) { return [Math.floor(x / CHUNK_SIZE), Math.floor(z / CHUNK_SIZE)]; }
  inBounds(x, y, z) { return x >= 0 && y >= 0 && z >= 0 && x < WORLD_X && y < WORLD_Y && z < WORLD_Z; }
  get(x, y, z) { return this.blocks.get(this.key(x, y, z)); }
  isSolid(t) { return t !== undefined && t !== BLOCKS.LEAF; }
  isOpaque(t) { return t !== undefined && t !== BLOCKS.LEAF; }
  canPlaceAt(x, y, z) { return this.inBounds(x, y, z) && this.get(x, y, z) === undefined; }
  markChunkDirtyByBlock(x, z) {
    const [cx, cz] = this.chunkOf(x, z);
    for (let dz = -1; dz <= 1; dz++) for (let dx = -1; dx <= 1; dx++) this.dirtyChunks.add(this.chunkKey(cx + dx, cz + dz));
  }
  consumeDirtyChunks() { const out = [...this.dirtyChunks]; this.dirtyChunks.clear(); return out; }
  set(x, y, z, t) { if (!this.inBounds(x, y, z)) return; this.blocks.set(this.key(x, y, z), t); this.markChunkDirtyByBlock(x, z); }
  del(x, y, z) { this.blocks.delete(this.key(x, y, z)); this.markChunkDirtyByBlock(x, z); }
  addTree(x, z, h) {
    const trunk = 3 + ((hash2(x * 2, z * 2) * 3) | 0);
    for (let y = h + 1; y <= h + trunk; y++) this.set(x, y, z, BLOCKS.WOOD);
    const top = h + trunk;
    for (let dx = -2; dx <= 2; dx++) for (let dz = -2; dz <= 2; dz++) for (let dy = -1; dy <= 2; dy++) {
      const d = Math.abs(dx) + Math.abs(dz) + Math.abs(dy);
      const ax = x + dx, ay = top + dy, az = z + dz;
      if (d <= 4 && this.inBounds(ax, ay, az) && this.get(ax, ay, az) === undefined) this.set(ax, ay, az, BLOCKS.LEAF);
    }
  }
  generate() {
    this.blocks.clear();
    for (let x = 0; x < WORLD_X; x++) for (let z = 0; z < WORLD_Z; z++) {
      const h = Math.max(1, Math.min(WORLD_Y - 6, Math.floor(2 + fbm(x * 0.055, z * 0.055) * 10 + fbm((x + 70) * 0.09, (z + 70) * 0.09) * 4)));
      this.heights[x + z * WORLD_X] = h;
      for (let y = 0; y <= h; y++) {
        let t = BLOCKS.STONE;
        if (y === h) t = h <= WATER_LEVEL + 1 ? BLOCKS.DIRT : BLOCKS.GRASS;
        else if (y >= h - 2) t = BLOCKS.DIRT;
        this.blocks.set(this.key(x, y, z), t);
      }
    }
    for (let x = 2; x < WORLD_X - 2; x++) for (let z = 2; z < WORLD_Z - 2; z++) {
      const h = this.heights[x + z * WORLD_X];
      if (h > WATER_LEVEL + 1 && hash2(x * 13.7, z * 9.1) > 0.982) this.addTree(x, z, h);
    }
    this.dirtyChunks.clear();
    for (let cx = 0; cx < Math.ceil(WORLD_X / CHUNK_SIZE); cx++) for (let cz = 0; cz < Math.ceil(WORLD_Z / CHUNK_SIZE); cz++) this.dirtyChunks.add(this.chunkKey(cx, cz));
    this.save();
  }
  save() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify([...this.blocks.entries()]));
    localStorage.setItem(STORAGE_KEY + '_h', JSON.stringify(this.heights));
  }
  load() {
    const raw = localStorage.getItem(STORAGE_KEY), rawH = localStorage.getItem(STORAGE_KEY + '_h');
    if (!raw || !rawH) return false;
    try {
      this.blocks = new Map(JSON.parse(raw));
      JSON.parse(rawH).forEach((v, i) => this.heights[i] = v);
      this.dirtyChunks.clear();
      for (let cx = 0; cx < Math.ceil(WORLD_X / CHUNK_SIZE); cx++) for (let cz = 0; cz < Math.ceil(WORLD_Z / CHUNK_SIZE); cz++) this.dirtyChunks.add(this.chunkKey(cx, cz));
      return true;
    } catch { return false; }
  }
}
"""

